{
  "name": "pokedev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A fast Pokédex web app built with React and Vite, using PokéAPI data",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "data": "node scripts/build-data.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "^30.1.2",
    "sharp": "0.35.5",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
