n":true}],"genus":"垃圾袋宝可梦","flavor":"诞生于塞满垃圾的垃圾袋里。它嘴里喷出的毒气是伽勒尔双弹瓦斯的最爱。","evolution":[[568],[569]]},"569":{"height":19,"weight":1073,"baseExp":166,"stats":[80,95,82,60,82,75],"abilities":[{"name":"stench","hidden":false},{"name":"weak-armor","hidden":false},{"name":"aftermath","hidden":true}],"genus":"垃圾场宝可梦","flavor":"从右臂喷出的毒液十分危险，虚弱的生物只要一沾到，立刻就会丢掉性命。","evolution":[[568],[569]]},"570":{"height":7,"weight":125,"baseExp":66,"stats":[40,65,40,80,40,65],"abilities":[{"name":"illusion","hidden":false}],"genus":"恶狐宝可梦","flavor":"为了寻找食物，有时甚至会幻化成人类出现在城镇里。多数情况下会幻化成小孩。","evolution":[[570],[571]]},"571":{"height":16,"weight":811,"baseExp":179,"stats":[60,105,60,120,60,105],"abilities":[{"name":"illusion","hidden":false}],"genus":"妖狐宝可梦","flavor":"孤独的训练家会命令索罗亚克为自己展现幻像，借以排遣孤身一人的寂寞。","evolution":[[570],[571]]},"572":{"height":4,"weight":58,"baseExp":60,"stats":[55,50,40,40,40,75],"abilities":[{"name":"cute-charm","hidden":false},{"name":"technician","hidden":false},{"name":"skill-link","hidden":true}],"genus":"栗鼠宝可梦","flavor":"用尾巴互相抚摸来打招呼。尾巴的毛比较蓬松的那一方会表现得稍微威风些。","evolution":[[572],[573]]},"573":{"height":5,"weight":75,"baseExp":165,"stats":[75,95,60,65,60,115],"abilities":[{"name":"cute-charm","hidden":false},{"name":"technician","hidden":false},{"name":"skill-link","hidden":true}],"genus":"围巾宝可梦","flavor":"覆盖着特别油脂的毛发可以挡住攻击。这种油以高价在市场上流通。","evolution":[[572],[573]]},"574":{"height":4,"weight":58,"baseExp":58,"stats":[45,30,50,55,65,45],"abilities":[{"name":"frisk","hidden":false},{"name":"competitive","hidden":false},{"name":"shadow-tag","hidden":true}],"genus":"凝视宝可梦","flavor":"哥德宝宝会在看似无人的地方轻声地叫。它好像是在与某种只有它才看得见的东西说话。","evolution":[[574],[575],[576]]},"575":{"height":7,"weight":180,"baseExp":137,"stats":[60,45,70,75,85,55],"abilities":[{"name":"frisk","hidden":false},{"name":"competitive","hidden":false},{"name":"shadow-tag","hidden":true}],"genus":"操纵宝可梦","flavor":"哥德小童的精神力量似乎会在星光闪耀的夜晚达到最高点。它与宇宙的关系至今不明。","evolution":[[574],[575],[576]]},"576":{"height":15,"weight":440,"baseExp":221,"stats":[70,55,95,95,110,65],"abilities":[{"name":"frisk","hidden":false},{"name":"competitive","hidden":false},{"name":"shadow-tag","hidden":true}],"genus":"天体宝可梦","flavor":"从哥德小姐那里看到了自己下场的恶人在那之后便销声匿迹了。","evolution":[[574],[575],[576]]}}