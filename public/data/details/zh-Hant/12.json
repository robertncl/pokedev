"name":"overgrow","hidden":false},{"name":"grassy-surge","hidden":true}],"genus":"鼓手寶可夢","flavor":"打鼓技巧最高超的那一隻會成為首領。性情溫和，重視族群的和諧相處。","evolution":[[810],[811],[812]]},"813":{"height":3,"weight":45,"baseExp":62,"stats":[50,71,40,40,40,69],"abilities":[{"name":"blaze","hidden":false},{"name":"libero","hidden":true}],"genus":"兔子寶可夢","flavor":"一旦做好了戰鬥的準備，牠鼻頭上和腳底的肉球就會散發出極度的高溫。","evolution":[[813],[814],[815]]},"814":{"height":6,"weight":90,"baseExp":147,"stats":[65,86,60,55,60,94],"abilities":[{"name":"blaze","hidden":false},{"name":"libero","hidden":true}],"genus":"兔子寶可夢","flavor":"會用腳把樹果從樹木上踢落，用來練習挑球，藉此鍛鍊自己的腳法。","evolution":[[813],[814],[815]]},"815":{"height":14,"weight":330,"baseExp":265,"stats":[80,116,75,65,75,119],"abilities":[{"name":"blaze","hidden":false},{"name":"libero","hidden":true}],"genus":"前鋒寶可夢","flavor":"擁有熟練的進攻和防守技巧。只要得到聲援就會更有衝勁，但有時會為了出風頭而弄巧成拙。","evolution":[[813],[814],[815]]},"816":{"height":3,"weight":40,"baseExp":62,"stats":[50,40,40,70,40,70],"abilities":[{"name":"torrent","hidden":false},{"name":"sniper","hidden":true}],"genus":"水蜥寶可夢","flavor":"皮膚在濕掉時會變色，彷彿像是隱身了一樣，誰都看不見牠的身影。","evolution":[[816],[817],[818]]},"817":{"height":7,"weight":115,"baseExp":147,"stats":[65,60,55,95,55,90],"abilities":[{"name":"torrent","hidden":false},{"name":"sniper","hidden":true}],"genus":"水蜥寶可夢","flavor":"頭腦聰明但是很怕麻煩。為了不讓敵人接近自己的地盤，在各個地方都設下了陷阱。","evolution":[[816],[817],[818]]},"818":{"height":19,"weight":452,"baseExp":265,"stats":[70,85,65,125,65,120],"abilities":[{"name":"torrent","hidden":false},{"name":"sniper","hidden":true}],"genus":"特工寶可夢","flavor":"能從指尖射出速度高達３馬赫的水槍。牠的瞬膜能幫助牠看穿敵人的弱點，準確地擊中要害。","evolution":[[816],[817],[818]]},"819":{"height":3,"weight":25,"baseExp":55,"stats":[70,55,55,35,35,25],"abilities":[{"name":"cheek-pouch","hidden":false},{"name":"gluttony","hidden":true}],"genus":"貪吃寶可夢","flavor":"由於牠無論何時都在吃樹果，使得牠比外表看起來還要頑強。會出現在田地裡尋找樹果。","evolution":[[819],[820]]},"820":{"height":6,"weight":60,"baseExp":161,"stats":[120,95,95,55,75,20],"abilities":[{"name":"cheek-pouch","hidden":false},{"name":"gluttony","hidden":true}],"genus":"貪慾寶可夢","flavor":"無論多麼堅硬的樹果殼都能用引以為傲的大牙咬碎。在伽勒爾是很常見的寶可夢。","evolution":[[819],[820]]},"821":{"height":2,"weight":18,"baseExp":49,"stats":[38,47,35,33,35,57],"abilities":[{"name":"keen-eye","hidden":false},{"name":"unnerve","hidden":false},{"name":"big-pecks","hidden":true}],"genus":"小鳥寶可夢","flavor":"嬌小的體型讓牠能敏捷地飛翔。攻其不備的戰法將體型巨大的對手玩弄於股掌之間。","evolution":[[821],[822],[823]]},"822":{"height":8,"weight":160,"baseExp":128,"stats":[68,67,55,43,55,77],"abilities":[{"name":"keen-eye","hidden":false},{"name":"unnerve","hidden":false},{"name":"big-pecks","hidden":true}],"genus":"烏鴉寶可夢","flavor":"歷經無數次艱難的戰鬥後，牠學會了該如何正確地判斷敵人的力量。","evolution":[[821],[822],[823]]},"823":{"height":22,"weight":750,"baseExp":248,"stats":[98,87,105,53,85,67],"abilities":[{"name":"pressure","hidden":false},{"name":"unnerve","hidden":false},{"name":"mirror-armor","hidden":true}],"genus":"烏鴉寶可夢","flavor":"擁有優秀飛行能力和極度聰明頭腦的牠在伽勒爾地區從事飛翔計程車的工作。","evolution":[[821],[822],[823]]},"824":{"height":4,"weight":80,"baseExp":36,"stats":[25,20,20,25,45,45],"abilities":[{"name":"swarm","hidden":false},{"name":"compound-eyes","hidden":false},{"name":"telepathy","hidden":true}],"genus":"幼蟲寶可夢","flavor":"經常出現在田地裡的寶可夢。會透過長在身體上的毛來感應周圍發生的事。","evolution":[[824],[825],[826]]},"825":{"height":4,"weight":195,"baseExp":117,"stats":[50,35,80,50,90,30],"abilities":[{"name":"swarm","hidden":false},{"name":"compound-eyes","hidden":false},{"name":"telepathy","hidden":true}],"genus":"天線罩寶可夢","flavor":"正在殼裡成長著。用精神力量掌握外界的狀況，做好進化的準備。","evolution":[[824],[825],[826]]},"826":{"height":4,"weight":408,"baseExp":253,"stats":[60,45,110,80,120,90],"abilities":[{"name":"swarm","hidden":false},{"name":"frisk","hidden":false},{"name":"telepathy","hidden":true}],"genus":"七星寶可夢","flavor":"釋放出精神力量來調查周圍的情況。牠的偵測範圍甚至可以達到方圓１０公里。","evolution":[[824],[825],[826]]},"827":{"height":6,"weight":89,"baseExp":49,"stats":[40,28,28,47,52,50],"abilities":[{"name":"run-away","hidden":false},{"name":"